generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ReservationStatus {
  ACTIVE
  EXPIRED
  PAYMENT_PENDING
  CONVERTED
  CANCELLED
}

enum QueueStatus {
  WAITING
  ALLOCATED
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  PENDING
  PROCESSING
  PAID
  EXPIRED
  CANCELLED
  REFUND_REQUIRED
}

enum PaymentEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

model Product {
  id             String @id @default(cuid())
  name           String
  totalStock     Int    @default(20)
  availableStock Int    @default(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations Reservation[]
  orders       Order[]
  queueEntries QueueEntry[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  demo      Boolean  @default(false)
  createdAt DateTime @default(now())

  reservations Reservation[]
  orders       Order[]
  queueEntries QueueEntry[]
}

model Reservation {
  id String @id @default(cuid())

  userId    String
  productId String

  quantity Int @default(1)

  status ReservationStatus @default(ACTIVE)

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  order Order?

  @@index([status, expiresAt])
  @@index([userId, status])
}

model Order {
  id String @id @default(cuid())

  userId        String
  productId     String
  reservationId String @unique

  quantity Int

  status OrderStatus @default(PENDING)

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])
  reservation Reservation @relation(fields: [reservationId], references: [id])

  paymentEvents PaymentEvent[]

  @@index([userId, status])
}

model QueueEntry {
  id String @id @default(cuid())

  userId    String
  productId String

  status QueueStatus @default(WAITING)

  position BigInt @unique @default(autoincrement())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([productId, status, position])
  @@index([userId, status])
}

model PaymentEvent {
  id String @id @default(cuid())

  providerEventId String @unique
  orderId         String
  type            String
  order           Order  @relation(fields: [orderId], references: [id])

  status PaymentEventStatus @default(RECEIVED)

  payload Json

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([orderId, status])
}

// Each row is a durable delivery, including deliberate duplicate deliveries.
model PaymentDelivery {
  id          String    @id @default(cuid())
  event       Json
  dueAt       DateTime
  deliveredAt DateTime?
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([deliveredAt, dueAt])
}
